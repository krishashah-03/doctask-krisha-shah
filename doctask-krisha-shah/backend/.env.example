DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctask
STORAGE_ROOT=./storage
OPENROUTER_API_KEY=changeme
SUPERDOCS_API_KEY=changeme

# "mock" (default, no key needed), "openrouter", "gemini", or "ollama" (local, no key needed)
LLM_PROVIDER=mock
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Leave blank for a local Ollama server. For Ollama Cloud, set
# OLLAMA_BASE_URL=https://ollama.com and provide your API key below.
OLLAMA_API_KEY=
