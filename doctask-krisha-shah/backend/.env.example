DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctask
STORAGE_ROOT=./storage
SUPERDOCS_API_KEY=changeme

# "mock" (default, no key needed), "ollama", or "groq"
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Leave blank for a local Ollama server. For Ollama Cloud, set
# OLLAMA_BASE_URL=https://ollama.com and provide your API key below.
OLLAMA_API_KEY=
# Free tier, no card required: https://console.groq.com/keys
GROQ_API_KEY=changeme
GROQ_MODEL=openai/gpt-oss-20b
